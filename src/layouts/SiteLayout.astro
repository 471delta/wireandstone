---
import "../styles/global.css";
const { title = "Wires & STONE" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2eadf" />
    <meta name="description" content="Wires & STONE" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-noise" aria-hidden="true"></div>
    <div class="site-rail site-rail--left" aria-hidden="true"></div>
    <div class="site-rail site-rail--right" aria-hidden="true"></div>
    <slot />
    <div class="cursor-ornament" aria-hidden="true">
      <span></span><i></i>
    </div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
